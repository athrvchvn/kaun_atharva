---
// A passage between two acts. The scroll drives the video timeline, so the
// visitor moves the animation themselves and it reads as walking through a
// door into the next phase — rather than a loop playing beside them.
//
// Drop site/public/media/bg/<id>.mp4 and the passage appears. Without the file
// the section renders as a quiet titled gap, so the page is never broken.
import { backdropFor } from '../data/media';

interface Props {
  id: string;      // t-0-1, t-1-2, …
  label: string;   // the phrase shown as you pass through
  tall?: boolean;  // scroll distance; longer = slower passage
}
const { id, label, tall = false } = Astro.props;
const clip = backdropFor(id);
---

<section class:list={['scrub', { tall, empty: !clip }]} data-scrub={clip ? clip.src : null} aria-hidden="true">
  <div class="stick">
    {clip && <video poster={clip.poster || undefined} muted playsinline preload="none"></video>}
    <div class="veil"></div>
    <p class="mono label">{label}</p>
    <div class="ring" hidden><i></i></div>
  </div>
</section>

<style>
  /* The section is tall; the frame inside it is pinned. Scrolling the height of
     the section is what moves the video from first frame to last.
     Sized at 170vh (70vh of travel) rather than 220: once projects became one
     per screen the page tripled, and five passages at 220vh would have made
     ~30% of the whole site a transition. */
  .scrub { position: relative; height: 170vh; }
  .scrub.tall { height: 240vh; }
  .scrub.empty { height: 55vh; }

  .stick {
    position: sticky; top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid; place-items: center;
  }
  .stick video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, var(--ink) 0%, rgba(10,12,14,0) 22%, rgba(10,12,14,0) 78%, var(--ink) 100%),
      rgba(10,12,14,0.25);
  }
  .label {
    position: relative;
    color: var(--bone);
    letter-spacing: 0.32em;
    font-size: var(--t-micro);
    text-align: center;
    padding-inline: 1.5rem;
    /* the footage under this changes completely across the scrub — by the end
       the caption sits over the brightest part of the frame. a scrim carried
       by the text itself stays legible wherever the passage happens to be. */
    text-shadow:
      0 1px 10px rgba(10, 12, 14, 0.95),
      0 0 26px rgba(10, 12, 14, 0.8),
      0 0 60px rgba(10, 12, 14, 0.6);
  }
  .scrub.empty .label { color: var(--steel-dim); }

  /* shown only while a large clip is still arriving */
  .ring {
    position: absolute; bottom: 2rem;
    width: 2rem; height: 2rem;
    border: 1px solid var(--hairline-2); border-radius: 50%;
  }
  .ring i {
    position: absolute; inset: -1px;
    border: 1px solid transparent; border-top-color: var(--brass);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* On a phone the passage plays rather than scrubs, so its height no longer
     has to buy scrub travel — and five passages at 170vh was roughly eight
     screens of pure transition on a small display, which is where the page
     started to feel like it was padding itself. */
  @media (max-width: 55.99rem) {
    .scrub { height: 105vh; }
    .scrub.tall { height: 130vh; }
    .scrub.empty { height: 40vh; }
  }

  /* no scroll-driven motion for anyone who asked not to have it */
  @media (prefers-reduced-motion: reduce) {
    .scrub { height: 70vh; }
    .scrub.tall { height: 70vh; }
    .ring { display: none; }
  }
</style>

<script>
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // width, not pointer type alone: a touch laptop scrubs fine, a large phone
  // does not, and the layout already treats 56rem as the line between the two.
  const MOBILE = matchMedia('(max-width: 55.99rem)').matches;

  document.querySelectorAll<HTMLElement>('.scrub[data-scrub]').forEach((section) => {
    const video = section.querySelector('video') as HTMLVideoElement | null;
    const ring = section.querySelector('.ring') as HTMLElement | null;
    const src = section.dataset.scrub;
    if (!video || !src) return;

    if (REDUCED) { video.preload = 'metadata'; video.src = src; return; }

    // Phones do not scrub. The desktop path below fetches the whole clip as a
    // Blob and then writes currentTime once per animation frame — a full
    // download plus a seek storm, which are the two things mobile hardware
    // handles worst, and there are five of these passages. Playing the clip
    // while it is on screen gives the same footage and the same sense of moving
    // through something, but it streams instead of buffering whole, decodes on
    // the hardware path, and costs nothing per scroll event.
    if (MOBILE) {
      video.loop = true;
      new IntersectionObserver(
        (es) => es.forEach((e) => {
          if (e.isIntersecting) {
            if (!video.src) { video.preload = 'auto'; video.src = src; }
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }),
        { threshold: 0.15 }
      ).observe(section);
      return;
    }

    // ---- Range rule: some hosts don't serve partial content, and then every
    // seek clamps to zero. Fetching the whole file as a Blob works everywhere.
    let loaded = false;
    const load = async () => {
      if (loaded) return;
      loaded = true;
      ring?.removeAttribute('hidden');
      try {
        const res = await fetch(src);
        // preload="none" is honoured strictly by Firefox: assigning src alone
        // never fires loadedmetadata, so the await below would hang forever and
        // the spinner would sit there. Flip preload and call load() explicitly.
        video.preload = 'auto';
        video.src = URL.createObjectURL(await res.blob());
        video.load();
        await Promise.race([
          new Promise<void>((ok) => {
            if (video.readyState >= 1) return ok();
            video.addEventListener('loadedmetadata', () => ok(), { once: true });
          }),
          // never let a missing event strand the UI
          new Promise<void>((ok) => setTimeout(ok, 5000)),
        ]);
      } catch {
        video.preload = 'auto';
        video.src = src;   // fall back to direct playback
        video.load();
      }
      ring?.setAttribute('hidden', '');
      onScroll();          // land on the current scroll position, not frame 0
    };

    // only fetch when the passage is close — five of these must not all
    // download on arrival at the top of the page
    new IntersectionObserver(
      (es) => es.forEach((e) => e.isIntersecting && load()),
      { rootMargin: '150% 0px' }
    ).observe(section);

    // ---- gated seeks: never write currentTime while one is in flight, or the
    // requests pile up and Chrome goes choppy. Coalesce to the newest target.
    let seekBusy = false;
    let pending: number | null = null;
    const requestSeek = (t: number) => {
      if (!Number.isFinite(t)) return;
      if (seekBusy) { pending = t; return; }
      seekBusy = true;
      try { video.currentTime = t; } catch { seekBusy = false; }
    };
    video.addEventListener('seeked', () => {
      seekBusy = false;
      if (pending !== null) { const t = pending; pending = null; requestSeek(t); }
    });
    video.addEventListener('error', () => { seekBusy = false; });

    // ---- lerp toward the target and rest when converged, so the rAF loop
    // isn't free-running and draining battery all the way down the page.
    let target = 0, shown = 0, raf = 0;
    const tick = () => {
      raf = 0;
      const d = video.duration;
      if (!d || Number.isNaN(d)) return;
      shown += (target - shown) * 0.14;
      if (Math.abs(target - shown) < 0.0015) shown = target;
      requestSeek(shown * d);
      if (shown !== target) raf = requestAnimationFrame(tick);
    };

    const progress = () => {
      const r = section.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      if (span <= 0) return 0;
      return Math.min(1, Math.max(0, -r.top / span));
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        target = progress();
        if (!raf) raf = requestAnimationFrame(tick);
      });
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
  });
</script>
