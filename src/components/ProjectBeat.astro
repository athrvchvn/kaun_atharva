---
// One project = one beat in the scroll. Video sticks to one side and plays only
// while it is on screen; the text moves past it. This replaces the card grid,
// which was a résumé with borders.
import type { Project } from '../data/projects';
import { mediaFor, stillsFor, pairMedia } from '../data/media';

interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
const flip = index % 2 === 1;          // alternate sides so the scroll has rhythm
const media = p.pair ? null : mediaFor(p.slug);
const stills = p.pair ? [] : stillsFor(p.slug);  // two shown, the rest behind "explore"
const pair = p.pair ? pairMedia(p.pair) : [];

// One project per screen — but weight is editorial, not uniform. A project with
// footage, a written page or a real outcome earns the full viewport; a one-line
// entry gets half. Same feeling where it matters, ~a third off the page length,
// and the pacing itself signals which work is significant. A paired beat (minor
// club builds shown two-up) stays half-height even with images — the point of
// pairing them is that neither is important enough alone for the full screen.
const major = !p.pair && (Boolean(media) || Boolean(p.deep) || Boolean(p.outcome));
---

<article class:list={['beat', { flip, major }]} id={`p-${p.slug}`}>
  <div class="beat-media">
    <div class="sticky">
      {p.pair && (
        <div class="pair" data-count={pair.length}>
          {pair.length > 0 ? pair.map((m) => (
            <img src={m.src} alt={`${m.slug} — part of ${p.title}`} loading="lazy" decoding="async" />
          )) : (
            <div class="empty" aria-hidden="true"><span class="mono">no footage yet</span></div>
          )}
        </div>
      )}
      {!p.pair && media?.kind === 'video' && (
        <video
          src={media.src}
          poster={media.poster || undefined}
          muted loop playsinline preload="none"
          data-autoplay
          aria-label={`${p.title} — ${p.what}`}
        ></video>
      )}
      {!p.pair && media?.kind === 'image' && (
        <img src={media.src} alt={`${p.title} — ${p.what}`} loading="lazy" decoding="async" />
      )}
      {!p.pair && !media && <div class="empty" aria-hidden="true"><span class="mono">no footage yet</span></div>}
      {p.mediaNote && <p class="medianote mono">{p.mediaNote}</p>}

      {stills.length > 0 && (
        <div class="stills" data-gallery={JSON.stringify(stills)}>
          {stills.slice(0, 2).map((s, i) => (
            <button class="thumb" data-index={i} aria-label={`${p.title}, photo ${i + 1} of ${stills.length}`}>
              <img src={s} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
          <button class="explore" data-index="0">
            explore<span class="ct mono">{stills.length}</span>
          </button>
        </div>
      )}
    </div>
  </div>

  <div class="beat-text">
    <span class="mono yr">{p.yearLabel}</span>
    <h3 class="display">
      {p.deep ? <a href={`/work/${p.slug}`}>{p.title} <span class="arrow">→</span></a> : p.title}
    </h3>
    {p.problem && <p class="problem">{p.problem}</p>}
    <p class="what">{p.what}</p>
    {p.note && <p class="note mono">{p.note}</p>}
    {p.doc && (
      <p class="doc">
        <a href={p.doc.href} target="_blank" rel="noopener">{p.doc.label} <span class="arrow">↗</span></a>
      </p>
    )}
  </div>
</article>

<style>
  /* one project to a screen. free scroll, no snap — landing cleanly is the
     visitor's business, not the page's. */
  .beat {
    display: grid;
    gap: 1.5rem;
    align-content: center;
    padding-block: clamp(2.5rem, 7vh, 5rem);
    border-top: 1px solid var(--hairline);
    min-height: 62svh;
  }
  .beat.major { min-height: 100svh; }

  @media (min-width: 56rem) {
    .beat {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }
    /* The premise in the header comment — media holds while the words move past
       it — was never actually wired: `.sticky` had no rule anywhere, so every
       beat scrolled as one rigid block and the page read as a stack of separate
       cards. Stretching the media column gives the sticky child room to travel
       within its own beat, so the clip stays put as its text rides up alongside
       and only releases when the beat itself leaves. That continuity is what
       carries one beat into the next without a visible seam. */
    .beat-media { align-self: stretch; }
    .beat-media .sticky {
      position: sticky;
      top: max(9vh, calc((100svh - 68svh) / 2));
    }
    /* the wide column has to follow the media across the flip. `order` alone
       moves the items but leaves the track sizes put, which silently parked
       every alternating clip in the narrow column. */
    .beat.flip { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
    .beat.flip .beat-media { order: 2; }
    .beat.flip .beat-text  { order: 1; }
  }

  /* No fixed ratio and no letterbox. The archive mixes landscape and portrait
     phone video, so any single ratio has to pad one of them — and those bars
     read as an empty frame around the clip rather than disappearing into the
     background. Letting width/height stay `auto` under a max-width/max-height
     cap makes the element box exactly the media's own shape: it scales down to
     fit the column and the screen, keeps its aspect ratio, and cannot produce
     a bar. Portrait clips end up tall and narrow, which is correct. */
  .beat-media video,
  .beat-media img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 68svh;
    margin-inline: auto;
  }
  .empty {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 68svh;
    background: var(--ink-1);
    border: 1px solid var(--hairline);
  }
  /* on a phone the media and the words share one screen, so the clip yields */
  @media (max-width: 55.99rem) {
    .beat-media video, .beat-media img, .empty { max-height: 42svh; }
  }
  .empty {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(45deg, transparent 0 11px, rgba(255,255,255,0.014) 11px 22px),
      var(--ink-1);
  }

  /* Two minor builds side by side. No outer ratio either: forcing 16/10 here
     and halving it left each cell at ~0.8, so `cover` cropped more than half
     the width off a 16:9 photo. Each image now keeps its own shape and the row
     is only as tall as the shorter of the two allows. */
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    align-items: start;
  }
  /* no height cap here on purpose — each image is already only half a column
     wide, so its natural height is modest, and a cap fighting width:100% is
     exactly what puts bars back. */
  .pair img {
    display: block;
    width: 100%;
    height: auto;
  }
  .pair[data-count="1"] { grid-template-columns: 1fr; }
  .pair .empty { aspect-ratio: auto; }
  @media (max-width: 55.99rem) {
    .pair { max-height: 42svh; }
  }
  .medianote { padding-top: 0.6rem; color: var(--steel-dim); text-transform: none; letter-spacing: 0.02em; }

  /* two stills sit under the clip; everything else lives behind "explore" */
  .stills { display: flex; gap: 0.5rem; margin-top: 0.5rem; align-items: stretch; }
  .thumb {
    flex: 1 1 0; min-width: 0; padding: 0; border: 1px solid var(--hairline);
    background: var(--ink-1); cursor: pointer; overflow: hidden; line-height: 0;
    transition: border-color 0.2s var(--ease);
  }
  .thumb img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: opacity 0.2s var(--ease); }
  .thumb:hover { border-color: var(--brass); }
  .thumb:hover img { opacity: 0.82; }
  .explore {
    flex: 0 0 auto; font: inherit; font-size: var(--t-micro);
    font-family: var(--mono); letter-spacing: 0.08em; text-transform: uppercase;
    background: transparent; border: 1px solid var(--hairline); color: var(--bone-dim);
    padding: 0 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.45rem;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .explore:hover { color: var(--brass); border-color: var(--brass); }
  .explore .ct { color: var(--steel-dim); }

  .beat-text { display: grid; gap: 0.7rem; align-content: start; }
  .yr { color: var(--brass); }
  .beat-text h3 { font-size: clamp(1.3rem, 2.6vw, 1.9rem); }
  .beat-text h3 a { border-bottom: 1px solid var(--hairline-2); }
  .beat-text h3 a:hover { color: var(--brass); border-color: var(--brass); }
  .arrow { color: var(--brass); }
  .problem { color: var(--bone); font-style: italic; font-size: var(--t-lead); line-height: 1.45; }
  .what { color: var(--bone-dim); font-size: var(--t-small); line-height: 1.65; max-width: 34rem; }
  .note { text-transform: none; letter-spacing: 0.02em; color: var(--steel-dim); line-height: 1.55; }

  .doc { margin-top: 0.5rem; font-size: var(--t-small); }
  .doc a { color: var(--bone-dim); border-bottom: 1px solid var(--hairline-2); padding-bottom: 2px; }
  .doc a:hover { color: var(--brass); border-color: var(--brass); }
</style>
