---
import Base from '../../layouts/Base.astro';
import { work, M } from '../../data/projects';

const isSide = (f: string) => /award|intern/.test(f);
---

<Base title="projects — atharva chavan" description="Everything Atharva Chavan has worked on since 2024.">
  <main id="main">
    <header class="head">
      <h1>projects</h1>
      <p>what i’ve worked on since 2024. almost all of it in college labs, with friends.</p>
    </header>
    <div class="grid">
      {work.map((p) => {
        const src = M + (p.img || p.extras?.find((f) => !isSide(f)) || `${p.video}.jpg`);
        const inner = (
          <>
            <div class="media"><img src={src} alt="" loading="lazy" decoding="async" /></div>
            <div class="text">
              <span class="yr">{p.year}</span>
              <span class="t">{p.title}</span>
              <span class="s">{p.say}</span>
            </div>
          </>
        );
        return p.page
          ? <a class="item" href={`/work/${p.id}`}>{inner}</a>
          : <a class="item" href={`/#p=${p.id}`}>{inner}</a>;
      })}
    </div>
  </main>
</Base>

<style>
  main { background: var(--bg2); padding: clamp(56px, 8vw, 100px) 24px clamp(64px, 8vw, 110px); }
  .head { max-width: 1100px; margin: 0 auto 40px; }
  h1 { margin: 0 0 12px; font-size: clamp(40px, 6vw, 72px); line-height: 1.02; font-weight: 700; letter-spacing: -0.04em; }
  .head p { margin: 0; max-width: 34em; font-size: clamp(18px, 1.8vw, 21px); line-height: 1.45; color: var(--ink2); }
  .grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .item { background: var(--card); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; color: inherit; transition: transform .45s var(--ease), box-shadow .45s; }
  .item:hover { text-decoration: none; transform: translateY(-4px); box-shadow: 0 18px 50px rgba(0,0,0,.12); }
  .media { aspect-ratio: 16 / 10; background: var(--chip); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .text { padding: 16px 20px 20px; display: flex; flex-direction: column; gap: 4px; }
  .yr { font-size: 12px; font-weight: 600; color: var(--ink2); }
  .t { font-size: 18px; line-height: 1.25; font-weight: 600; color: var(--ink); }
  .s { font-size: 14px; line-height: 1.45; color: var(--ink2); }
</style>
