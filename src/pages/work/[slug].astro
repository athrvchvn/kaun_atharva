---
import Base from '../../layouts/Base.astro';
import { work, mediaOf, M } from '../../data/projects';

// Long write-ups live in src/content/work/<id>.md. A project gets a page
// when it has `page: true` in projects.ts and a matching markdown file.
const pages = import.meta.glob('../../content/work/*.md', { eager: true }) as Record<
  string,
  { Content: any }
>;

export async function getStaticPaths() {
  const { work } = await import('../../data/projects');
  return work.filter((p) => p.page).map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const withPages = work.filter((p) => p.page);
const i = withPages.findIndex((p) => p.id === slug);
const project = withPages[i];
const prev = withPages[(i - 1 + withPages.length) % withPages.length];
const next = withPages[(i + 1) % withPages.length];
const Content = Object.entries(pages).find(([path]) => path.endsWith(`/${slug}.md`))?.[1]?.Content;

const media = mediaOf(project);
const hero = media[0];
const photos = media.slice(1).filter((m) => m.kind === 'image');
const clip = media.find((m, k) => k > 0 && m.kind === 'video');
const ogImage = hero?.kind === 'video' ? hero.poster : hero?.src;
---

<Base title={`${project.title} — atharva chavan`} description={project.say} image={ogImage}>
  <main id="main">
    <header class="head">
      <a class="back" href="/#work">‹ all projects</a>
      <p class="eyebrow">{project.year}{project.line && ` · ${project.line}`}</p>
      <h1>{project.title}</h1>
      <p class="say">{project.say}</p>
    </header>

    {hero && (
      <figure class="hero">
        {hero.kind === 'video' ? (
          <video src={hero.src} poster={hero.poster} muted loop playsinline autoplay controls preload="metadata"
                 aria-label={project.title}></video>
        ) : (
          <img src={hero.src} alt={project.title} />
        )}
        {project.caption && hero.src === M + project.img && <figcaption>{project.caption}</figcaption>}
      </figure>
    )}

    <section class="summary">
      <div class="summary-text">
        {project.quote && <p class="quote">“{project.quote}”</p>}
        <p class="body">{project.body}</p>
        {project.deck && (
          <p class="deck"><a href={project.deck.href} target="_blank" rel="noopener">{project.deck.label} ↗</a></p>
        )}
      </div>
      {project.facts && (
        <dl class="facts">
          {project.facts.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
      )}
    </section>

    {photos.length > 0 && (
      <section class="photos" aria-label="photos">
        {photos.map((m) => (
          <a href={m.src} target="_blank" rel="noopener"><img src={m.src} alt="" loading="lazy" decoding="async" /></a>
        ))}
      </section>
    )}

    {Content && (
      <article class="long" data-reveal>
        <Content />
      </article>
    )}

    {clip && (
      <figure class="hero tail">
        <video src={clip.src} poster={clip.poster} muted loop playsinline controls preload="none" aria-label={`${project.title}, video`}></video>
      </figure>
    )}

    <nav class="pager" aria-label="more projects">
      <a href={`/work/${prev.id}`}><span>previous</span>‹ {prev.title}</a>
      <a href={`/work/${next.id}`} class="r"><span>next</span>{next.title} ›</a>
    </nav>
  </main>
</Base>

<style>
  main { background: var(--bg); padding-bottom: clamp(48px, 8vw, 96px); }
  .head { max-width: 980px; margin: 0 auto; padding: clamp(40px, 7vw, 88px) 24px clamp(28px, 4vw, 44px); }
  .back { display: inline-block; font-size: 15px; margin-bottom: clamp(24px, 4vw, 40px); }
  .eyebrow { margin: 0 0 10px; font-size: 17px; font-weight: 600; color: var(--ink2); }
  h1 { margin: 0 0 18px; font-size: clamp(44px, 7vw, 88px); line-height: 1; font-weight: 700; letter-spacing: -0.045em; }
  .say { margin: 0; max-width: 30em; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.35; font-weight: 500; letter-spacing: -0.015em; color: var(--ink2); text-wrap: balance; }

  .hero { max-width: 1100px; margin: 0 auto; padding: 0 clamp(14px, 3vw, 24px); }
  .hero video, .hero img { display: block; width: 100%; max-height: 78vh; object-fit: contain; background: #000; border-radius: clamp(18px, 3vw, 30px); }
  .hero figcaption { margin-top: 12px; font-size: 14px; color: var(--ink2); text-align: center; }
  .hero.tail { margin-top: clamp(40px, 6vw, 72px); max-width: 980px; }

  .summary { max-width: 980px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) 24px 0; display: grid; gap: clamp(28px, 5vw, 64px); grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 760px) { .summary { grid-template-columns: 1fr; } }
  .quote { margin: 0 0 18px; font-size: 24px; line-height: 1.3; font-weight: 600; letter-spacing: -0.02em; }
  .body { margin: 0; font-size: clamp(18px, 1.9vw, 21px); line-height: 1.5; text-wrap: pretty; }
  .body::first-letter { text-transform: uppercase; }
  .deck { margin: 18px 0 0; font-size: 17px; }
  .facts { margin: 0; background: var(--bg2); border-radius: 22px; padding: 6px 22px; }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .facts div:last-child { border-bottom: 0; }
  .facts dt { font-size: 12px; font-weight: 600; color: var(--ink2); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 3px; }
  .facts dd { margin: 0; font-size: 16px; line-height: 1.4; }

  .photos { max-width: 980px; margin: clamp(40px, 6vw, 64px) auto 0; padding: 0 24px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .photos a { display: block; aspect-ratio: 4 / 3; border-radius: 20px; overflow: hidden; background: var(--chip); }
  .photos img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s var(--ease); }
  .photos a:hover img { transform: scale(1.03); }

  .long { max-width: 692px; margin: clamp(56px, 8vw, 96px) auto 0; padding: 0 24px; font-size: 19px; line-height: 1.6; }
  .long :global(h2) { margin: 2.4em 0 .6em; font-size: clamp(26px, 3vw, 32px); line-height: 1.15; font-weight: 700; letter-spacing: -0.03em; }
  .long :global(h2:first-child) { margin-top: 0; }
  .long :global(p) { margin: 0 0 1.1em; }
  .long :global(ul), .long :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .long :global(li) { margin-bottom: .45em; }
  .long :global(strong) { font-weight: 600; }
  .long :global(code) { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .86em; background: var(--bg2); padding: .12em .4em; border-radius: 6px; }
  .long :global(blockquote) { margin: 0 0 1.2em; padding-left: 1em; border-left: 3px solid var(--line); color: var(--ink2); }
  .long :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.4em; font-size: 16px; }
  .long :global(th), .long :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .long :global(figure.vid) { margin: 2em 0; }
  .long :global(figure.vid video) { width: 100%; border-radius: 18px; background: #000; display: block; }

  .pager { max-width: 980px; margin: clamp(56px, 8vw, 96px) auto 0; padding: 24px 24px 0; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 24px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; font-size: 19px; font-weight: 600; min-width: 0; }
  .pager span { font-size: 13px; font-weight: 600; color: var(--ink2); }
  .pager .r { text-align: right; align-items: flex-end; }
</style>
