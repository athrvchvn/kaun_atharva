---
import Base from '../layouts/Base.astro';
import { work, early, all, M, mediaOf, type Project } from '../data/projects';

// Award and internship photos belong on the project page, not on the cover.
const isSide = (f: string) => /award|intern/.test(f);
const cover = (p: Project) =>
  M + (p.img || p.extras?.find((f) => !isSide(f)) || `${p.video}.jpg`);
const hover = (p: Project) => (p.video && !p.badVideo ? `${M}${p.video}.mp4` : '');

const dustbin = early[0];
const after = early.slice(1);

// Two rows of photos for the wall above "say hi".
const pics: { id: string; src: string }[] = [];
all.forEach((p) => {
  [p.img, ...(p.extras || [])]
    .filter((f): f is string => !!f && !isSide(f))
    .slice(0, 2)
    .forEach((f) => pics.push({ id: p.id, src: M + f }));
});
const rowA = pics.filter((_, i) => i % 2 === 0);
const rowB = pics.filter((_, i) => i % 2 === 1);

// Everything the quick-look sheet needs, handed to the client as JSON.
const sheet = Object.fromEntries(
  all.map((p) => [
    p.id,
    {
      title: p.title,
      eyebrow: p.year + (p.line ? ' · ' + p.line : ''),
      say: p.say,
      quote: p.quote || '',
      body: p.body,
      note: p.note || '',
      caption: p.caption || '',
      media: mediaOf(p),
      link: p.page ? `/work/${p.id}` : '',
      deck: p.deck || null,
    },
  ]),
);
const groups = { work: work.map((p) => p.id), early: early.map((p) => p.id) };
const json = JSON.stringify({ sheet, groups }).replace(/</g, '\\u003c');
---

<Base>
  <main id="main">
    <!-- ══ the film: a frame that opens up as you scroll ══ -->
    <section class="film" data-film-hero>
      <div class="film-stick">
        <div class="film-title">
          <h1 class="hi"><span>hi,</span> <span>i’m</span> <span>atharva.</span></h1>
          <p class="hi sub"><span>i study mechanical engineering at IIT Indore and like building small machines. this is how it started.</span></p>
        </div>
        <div class="film-clip" data-film-clip data-film-go>
          <video src="/media/act0-film.mp4" muted loop playsinline preload="auto" autoplay data-film
                 aria-label="how it started: the workshop, a welded chair, a friend's desk, and a dustbin"></video>
          <div class="film-shade" aria-hidden="true"></div>
          <div class="film-cue" aria-hidden="true">
            <span><span class="nudge">↓</span>scroll to watch the story</span>
          </div>
          <div class="film-cap">
            <div class="cap-wrap"><p data-cap aria-live="polite">my dad has a furniture workshop. i used to go there just to watch.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ projects reel ══ -->
    <section id="work" class="work">
      <div class="work-head" data-reveal>
        <h2>projects</h2>
        <p>what i’ve worked on since 2024, newest first. almost all of it in college labs, with friends.</p>
      </div>

      <div class="reel" data-reel>
        {work.map((p) => (
          <button class="card" data-card data-open={p.id} aria-label={p.title}>
            <img src={cover(p)} alt="" loading="lazy" decoding="async" />
            {hover(p) && <video data-hv={hover(p)} muted loop playsinline preload="none"></video>}
          </button>
        ))}
      </div>

      <div class="reel-foot">
        <div class="reel-row">
          <div class="captions">
            {work.map((p, i) => (
              <div class="cap" data-rc={i}>
                <span class="cap-year">{p.year}</span>
                <h3>{p.title}</h3>
                <p>{p.say}</p>
                <button class="more" data-open={p.id}>how it works ›</button>
              </div>
            ))}
          </div>
          <div class="steps">
            <button class="step" data-step="-1" aria-label="previous project">‹</button>
            <button class="step" data-step="1" aria-label="next project">›</button>
          </div>
        </div>
        <div class="index">
          {work.map((p, i) => <button data-go={i}>{p.title}</button>)}
        </div>
      </div>
    </section>

    <!-- ══ the first ones ══ -->
    <section id="story" class="story">
      <div class="story-in">
        <div class="story-head" data-reveal>
          <p class="kicker">2018 — 2022</p>
          <h2>the first ones.</h2>
          <p>an arduino, a breadboard, and a bag of parts i did not understand yet.</p>
          <p>i watched videos and tried to copy them with the parts i had, which was never the parts they had.</p>
        </div>

        <button class="first" data-reveal data-early data-open={dustbin.id} aria-label={dustbin.title}>
          <div class="first-media">
            <video src={`${M}${dustbin.video}.mp4`} poster={`${M}${dustbin.video}.jpg`} muted loop playsinline preload="none"></video>
          </div>
          <div class="first-text">
            <span class="kicker sm">2018 · i was eleven</span>
            <span class="first-title">smart dustbin</span>
            <span class="first-body">an ultrasonic sensor, a servo and a dustbin lid. walk up to it and the lid opens. the first thing i ever built.</span>
          </div>
        </button>

        <p class="kicker after" data-reveal>after that</p>
        <div class="early">
          {after.map((p) => (
            <button class="ecard" data-reveal data-early data-open={p.id} aria-label={p.title}>
              <div class="ecard-media">
                <video src={`${M}${p.video}.mp4`} poster={`${M}${p.video}.jpg`} muted loop playsinline preload="none"></video>
              </div>
              <div class="ecard-text">
                <span class="ecard-year">{p.year.replace('~', 'around ')}</span>
                <span class="ecard-title">{p.title}</span>
                <span class="ecard-body">{p.say}</span>
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ contact ══ -->
    <section id="contact" class="contact">
      <div class="wall" aria-hidden="true" data-reel-wall>
        {[rowA, rowB].map((row, r) => (
          <div class:list={['wall-row', { rev: r === 1 }]}>
            {[...row, ...row].map((w) => (
              <button tabindex="-1" data-open={w.id}><img src={w.src} alt="" loading="lazy" decoding="async" /></button>
            ))}
          </div>
        ))}
      </div>
      <div class="contact-in">
        <h2 data-reveal>say hi.</h2>
        <p data-reveal>if you’d like to talk about any of this, email is the easiest way to reach me.</p>
        <a data-reveal class="mail" href="mailto:atharvachavan346@gmail.com">atharvachavan346@gmail.com</a>
        <div data-reveal class="pills center">
          <a class="pill" href="tel:+919309147663">+91 93091 47663</a>
          <a class="pill" href="https://github.com/athrvchvn" rel="noopener">github ↗</a>
          <a class="pill" href="https://www.linkedin.com/in/athrvchavan" rel="noopener">linkedin ↗</a>
        </div>
      </div>
    </section>
  </main>

  <!-- quick-look sheet, filled by the script below -->
  <div class="backdrop" id="sheet" hidden>
    <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sh-title">
      <button class="sh-close" data-close aria-label="close">✕</button>
      <div class="sh-stage" id="sh-stage"></div>
      <div class="sh-thumbs" id="sh-thumbs"></div>
      <div class="sh-body">
        <span class="sh-eyebrow" id="sh-eyebrow"></span>
        <h3 id="sh-title"></h3>
        <p class="sh-say" id="sh-say"></p>
        <p class="sh-quote" id="sh-quote"></p>
        <p class="sh-text" id="sh-text"></p>
        <p class="sh-note" id="sh-note"></p>
        <div class="sh-links" id="sh-links"></div>
      </div>
      <div class="sh-nav">
        <button data-prev id="sh-prev"></button>
        <button data-next id="sh-next"></button>
      </div>
    </div>
  </div>

  <script type="application/json" id="ka-data" set:html={json} />

  <script is:inline>
  (function () {
    var DATA = JSON.parse(document.getElementById('ka-data').textContent);
    var $ = function (s, r) { return (r || document).querySelector(s); };
    var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var play = function (v) { if (!v) return; v.muted = true; var p = v.play(); if (p && p.catch) p.catch(function () {}); };

    // ── the film ──────────────────────────────────────────────
    var hero = $('[data-film-hero]'), clip = $('[data-film-clip]'), film = $('[data-film]'), cap = $('[data-cap]');
    function fh() {
      var r = hero.getBoundingClientRect(), span = Math.max(1, r.height - innerHeight);
      var raw = Math.max(0, Math.min(1, -r.top / span)), p = Math.min(1, raw / 0.62);
      p = p * p * (3 - 2 * p);
      hero.style.setProperty('--p', p.toFixed(4));
      var vw = innerWidth, vh = innerHeight;
      var side = Math.max(20, vw / 2 - 560) * (1 - p), top = (vh * 0.5 + 10) * (1 - p), bot = vh * 0.05 * (1 - p), rad = 30 * (1 - p);
      var v = 'inset(' + top.toFixed(1) + 'px ' + side.toFixed(1) + 'px ' + bot.toFixed(1) + 'px ' + side.toFixed(1) + 'px round ' + rad.toFixed(1) + 'px)';
      clip.style.clipPath = v; clip.style.webkitClipPath = v;
    }
    var ticking = false;
    addEventListener('scroll', function () { if (ticking) return; ticking = true; requestAnimationFrame(function () { ticking = false; fh(); }); }, { passive: true });
    addEventListener('resize', fh); fh();
    clip.addEventListener('click', function () {
      var r = hero.getBoundingClientRect(); if (r.top < -10) return;
      scrollTo({ top: scrollY + r.top + (r.height - innerHeight) * 0.66, behavior: 'smooth' });
    });

    var START = 10.2;
    var CAPS = [
      [0, 'my dad has a furniture workshop. i used to go there just to watch.'],
      [15.5, 'one day i wanted a chair. there was a broken one lying around.'],
      [21.5, 'my uncle showed me how to weld it back together.'],
      [25, 'it held for a few months. then it broke again. i never fixed it.'],
      [33.5, 'so i cycled to a friend’s house instead.'],
      [39.5, 'he was building something at his desk. he didn’t explain much. i just watched.'],
      [46, 'then i went home and tried one on my own.'],
      [49.5, 'a dustbin that opens when you walk up to it. i was eleven.'],
    ];
    var capI = 0;
    film.muted = true;
    film.addEventListener('loadedmetadata', function () { if (film.currentTime < START) film.currentTime = START; });
    film.addEventListener('timeupdate', function () {
      if (film.currentTime < START - 0.3) { film.currentTime = START; return; }
      if (film.currentTime >= START) film.classList.add('on');
      var i = 0; for (var k = 0; k < CAPS.length; k++) if (film.currentTime >= CAPS[k][0]) i = k;
      if (i === capI) return; capI = i;
      cap.style.opacity = '0'; cap.style.transform = 'translateY(8px)';
      setTimeout(function () { cap.textContent = CAPS[i][1]; cap.style.opacity = '1'; cap.style.transform = 'none'; }, 500);
    });
    if (film.readyState >= 1 && film.currentTime < START) film.currentTime = START;
    if (!reduce) play(film);

    // ── the reel ──────────────────────────────────────────────
    var reel = $('[data-reel]'), cards = $$('[data-card]', reel), rc = $$('[data-rc]'), gos = $$('[data-go]');
    var fine = window.matchMedia && matchMedia('(hover:hover) and (pointer:fine)').matches;
    var vel = 0, want = 0, drifting = false, act = -1, pt = null;
    function center(i, smooth) {
      i = Math.max(0, Math.min(cards.length - 1, i)); var c = cards[i];
      reel.scrollTo({ left: c.offsetLeft + c.offsetWidth / 2 - reel.clientWidth / 2, behavior: smooth ? 'smooth' : 'auto' });
    }
    function nearest() {
      var mid = reel.scrollLeft + reel.clientWidth / 2, b = 0, bd = 1e12;
      cards.forEach(function (c, i) { var d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid); if (d < bd) { bd = d; b = i; } });
      return b;
    }
    function hv(c, on) {
      var v = c.querySelector('video[data-hv]'); if (!v) return;
      if (on) {
        if (!v.getAttribute('src')) { v.src = v.getAttribute('data-hv'); v.addEventListener('error', function () { v.remove(); }); }
        v.muted = true; var p = v.play(); if (p && p.then) p.then(function () { v.style.opacity = '1'; }).catch(function () {});
      } else { v.pause(); v.style.opacity = '0'; }
    }
    function setActive(i) {
      if (i === act) return; act = i;
      cards.forEach(function (c, k) { var on = k === i; c.classList.toggle('on', on); c.setAttribute('aria-current', on ? 'true' : 'false'); if (!on) hv(c, false); });
      clearTimeout(pt); if (!reduce) pt = setTimeout(function () { hv(cards[act], true); }, 260);
      rc.forEach(function (n) { n.classList.toggle('on', +n.getAttribute('data-rc') === i); });
      gos.forEach(function (n) { n.classList.toggle('on', +n.getAttribute('data-go') === i); });
    }
    function loop() {
      vel += (want - vel) * 0.07;
      if (Math.abs(vel) > 0.08) { reel.scrollLeft += vel; drifting = true; }
      else if (drifting && want === 0) { drifting = false; reel.style.scrollSnapType = ''; center(nearest(), true); }
      setActive(nearest());
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
    reel.addEventListener('mousemove', function (e) {
      if (!fine) return;
      var r = reel.getBoundingClientRect(), f = (e.clientX - r.left) / r.width, z = 0.16, s = 0;
      if (f < z) s = -(1 - f / z); else if (f > 1 - z) s = (f - (1 - z)) / z;
      if (s !== 0) reel.style.scrollSnapType = 'none';
      want = (s > 0 ? 1 : -1) * s * s * 9;
    }, { passive: true });
    reel.addEventListener('mouseleave', function () { want = 0; });

    // ── early cards play on hover ─────────────────────────────
    $$('[data-early]').forEach(function (c) {
      var v = c.querySelector('video');
      c.addEventListener('mouseenter', function () { if (!reduce) play(v); });
      c.addEventListener('mouseleave', function () { v.pause(); });
    });

    // ── the sheet ─────────────────────────────────────────────
    var sheet = $('#sheet'), stage = $('#sh-stage'), thumbs = $('#sh-thumbs');
    var sel = null, mi = 0, lastFocus = null;
    function group(id) { return DATA.groups.work.indexOf(id) >= 0 ? DATA.groups.work : DATA.groups.early; }
    function el(tag, attrs) { var n = document.createElement(tag); for (var k in attrs) n.setAttribute(k, attrs[k]); return n; }
    function showMedia() {
      var d = DATA.sheet[sel], m = d.media[mi]; stage.innerHTML = '';
      if (!m) return;
      if (m.kind === 'video') {
        var v = el('video', { src: m.src, poster: m.poster || '', controls: '', playsinline: '', loop: '' });
        v.muted = true; stage.appendChild(v); if (!reduce) play(v);
      } else {
        stage.appendChild(el('img', { src: m.src, alt: d.title }));
      }
      $$('button', thumbs).forEach(function (b, i) { b.classList.toggle('on', i === mi); });
    }
    function open(id) {
      if (!DATA.sheet[id]) return;
      if (sheet.hidden) lastFocus = document.activeElement;
      sel = id; mi = 0;
      var d = DATA.sheet[id], g = group(id), i = g.indexOf(id);
      $('#sh-eyebrow').textContent = d.eyebrow;
      $('#sh-title').textContent = d.title;
      $('#sh-say').textContent = d.say;
      var q = $('#sh-quote'); q.textContent = d.quote ? '“' + d.quote + '”' : ''; q.hidden = !d.quote;
      $('#sh-text').textContent = d.body;
      var n = $('#sh-note'); n.textContent = d.note; n.hidden = !d.note;
      var links = $('#sh-links'); links.innerHTML = '';
      if (d.link) { var a = el('a', { href: d.link }); a.textContent = 'read the full story ›'; links.appendChild(a); }
      if (d.deck) { var b = el('a', { href: d.deck.href, target: '_blank', rel: 'noopener' }); b.textContent = d.deck.label + ' ↗'; links.appendChild(b); }
      links.hidden = !links.children.length;
      thumbs.innerHTML = '';
      if (d.media.length > 1) d.media.forEach(function (m, k) {
        var t = el('button', { 'aria-label': (m.kind === 'video' ? 'video' : 'photo ' + k) });
        if (m.kind === 'video') t.textContent = '▶ video'; else t.appendChild(el('img', { src: m.src, alt: '', loading: 'lazy' }));
        t.addEventListener('click', function () { mi = k; showMedia(); });
        thumbs.appendChild(t);
      });
      thumbs.hidden = d.media.length < 2;
      $('#sh-prev').textContent = '‹ ' + DATA.sheet[g[(i - 1 + g.length) % g.length]].title;
      $('#sh-next').textContent = DATA.sheet[g[(i + 1) % g.length]].title + ' ›';
      showMedia();
      if (sheet.hidden) { sheet.hidden = false; document.documentElement.style.overflow = 'hidden'; $('.sh-close').focus(); }
      sheet.scrollTop = 0;
    }
    function close() {
      sheet.hidden = true; stage.innerHTML = ''; sel = null; document.documentElement.style.overflow = '';
      if (lastFocus) lastFocus.focus({ preventScroll: true });
    }
    function step(dlt) { var g = group(sel), i = g.indexOf(sel); open(g[(i + dlt + g.length) % g.length]); }

    sheet.addEventListener('click', function (e) {
      if (e.target === sheet || e.target.closest('[data-close]')) close();
      else if (e.target.closest('[data-prev]')) step(-1);
      else if (e.target.closest('[data-next]')) step(1);
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest || !sheet.hidden) return;
      var g = e.target.closest('[data-go]'); if (g) { center(+g.getAttribute('data-go'), true); return; }
      var st = e.target.closest('[data-step]'); if (st) { center(act + +st.getAttribute('data-step'), true); return; }
      var c = e.target.closest('[data-card]');
      if (c && c.getAttribute('aria-current') !== 'true') { e.preventDefault(); center(cards.indexOf(c), true); return; }
      var o = e.target.closest('[data-open]'); if (o) open(o.getAttribute('data-open'));
    });

    document.addEventListener('keydown', function (e) {
      if (!sheet.hidden) {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') step(1);
        else if (e.key === 'ArrowLeft') step(-1);
        return;
      }
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      var r = reel.getBoundingClientRect();
      if (r.bottom > 0 && innerHeight > r.top) { e.preventDefault(); center(act + (e.key === 'ArrowRight' ? 1 : -1), true); }
    });

    // deep link: /#p=dune opens that project
    var m = location.hash.match(/^#p=([\w-]+)/); if (m) open(m[1]);
  })();
  </script>
</Base>

<style>
  /* ── film ── */
  .film { --p: 0; position: relative; height: 270vh; margin-top: -49px; background: var(--bg); }
  .film-stick { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .film-title {
    position: absolute; left: 0; right: 0; top: 0; padding: calc(49px + 11vh) 24px 0; text-align: center;
    opacity: calc(1 - var(--p) * 2.4); transform: translateY(calc(var(--p) * -90px)) scale(calc(1 - var(--p) * .06)); transform-origin: 50% 0;
  }
  .film-title h1 { margin: 0 0 18px; font-size: clamp(48px, 8vw, 104px); line-height: 1; font-weight: 700; letter-spacing: -0.05em; }
  .film-title .sub { margin: 0 auto; max-width: 30em; font-size: clamp(18px, 2vw, 24px); line-height: 1.4; font-weight: 500; letter-spacing: -0.012em; color: var(--ink2); text-wrap: balance; }
  .hi > span { display: inline-block; opacity: 0; animation: kaHi 1.1s var(--ease) forwards; }
  .hi > span:nth-child(1) { animation-delay: .15s; } .hi > span:nth-child(2) { animation-delay: .3s; } .hi > span:nth-child(3) { animation-delay: .45s; }
  p.hi > span { animation-delay: .75s; }
  .film-clip {
    position: absolute; inset: 0; background: #000; cursor: pointer; will-change: clip-path;
    clip-path: inset(calc(50vh + 10px) max(20px, calc(50vw - 560px)) 5vh max(20px, calc(50vw - 560px)) round 30px);
    -webkit-clip-path: inset(calc(50vh + 10px) max(20px, calc(50vw - 560px)) 5vh max(20px, calc(50vw - 560px)) round 30px);
  }
  .film-clip video { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0; transition: opacity 1.6s ease; transform: scale(calc(1.12 - .12 * var(--p))); }
  .film-clip video.on { opacity: 1; }
  .film-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to bottom, rgba(0,0,0,.35) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0) 48%, rgba(0,0,0,.72) 100%); opacity: clamp(0, calc((var(--p) - .55) * 3), 1); }
  .film-cue { position: absolute; left: 0; right: 0; bottom: calc(5vh + 26px); display: flex; justify-content: center; pointer-events: none; opacity: calc(1 - var(--p) * 5); }
  .film-cue > span {
    display: flex; align-items: center; gap: 10px; padding: 11px 20px 11px 18px; border-radius: 980px;
    background: rgba(255,255,255,.18); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255,255,255,.28); color: #fff; font-size: 15px; font-weight: 500;
    opacity: 0; animation: kaHi 1s var(--ease) 1.4s forwards;
  }
  .nudge { display: block; font-size: 16px; line-height: 1; animation: kaNudge 1.6s ease-in-out infinite; }
  .film-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 clamp(24px, 6vw, 88px) clamp(56px, 11vh, 110px); pointer-events: none; opacity: clamp(0, calc((var(--p) - .8) * 6), 1); transform: translateY(calc((1 - var(--p)) * 30px)); }
  .cap-wrap { max-width: 1100px; margin: 0 auto; }
  .film-cap p { margin: 0; max-width: 20ch; color: #f5f5f7; min-height: 2.16em; display: flex; align-items: flex-end; font-size: clamp(28px, 4vw, 56px); line-height: 1.08; font-weight: 600; letter-spacing: -0.035em; text-wrap: balance; text-shadow: 0 2px 24px rgba(0,0,0,.35); transition: opacity .5s ease, transform .5s ease; }
  @media (prefers-reduced-motion: reduce) { .hi > span, .film-cue > span { animation: none; opacity: 1; } .nudge { animation: none; } }

  /* ── work ── */
  .work { --cw: max(min(86vw, 300px), min(86vw, 980px, calc((100vh - 340px) * 1.6))); background: var(--bg2); padding: clamp(72px, 9vw, 110px) 0 clamp(72px, 9vw, 120px); scroll-margin-top: 48px; }
  .work-head { width: var(--cw); margin: 0 auto 36px; display: flex; flex-direction: column; gap: 12px; }
